[Unit]
Description=Bounded production health checks and safe Web recovery
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/flock -n -E 75 /run/lock/jevhub-ops-global.lock /usr/local/bin/node /usr/local/lib/jevhub-ops/server-ops.mjs run /etc/jevhub-ops/policy.json
SuccessExitStatus=75
TimeoutStartSec=12min
Nice=10
CPUQuota=50%
MemoryMax=384M
UMask=0077
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/jevhub-ops /run/lock /home/ubuntu/jevhub/releases /home/ubuntu/jev-email/releases /home/ubuntu/jev-store-new-api/releases /home/ubuntu/jev-vip/releases

[Install]
WantedBy=multi-user.target
