# Optional Google Analytics 4 measurement ID.
# Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Optional self-hosted Umami tracking script.
# Example: https://analytics.example.com/script.js
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
# Public website ID created in Umami.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Optional comma-separated hostname allowlist.
# Example: jevhub.xyz,www.jevhub.xyz
NEXT_PUBLIC_UMAMI_DOMAINS=

# Required to make /playground execute real Jev requests.
# Keep this server-side. Never expose it through NEXT_PUBLIC_*.
TYPESAFE_API_KEY=

# Optional bounded playground controls.
JEV_PLAYGROUND_RATE_LIMIT=20
JEV_PLAYGROUND_TIMEOUT_MS=12000
# Optional model override. Defaults to jev-latest.
TYPESAFE_DEFAULT_MODEL=
